ANTHROPIC_API_KEY=
PORT=8787
BASE_URL=http://localhost:5173
# DATA_DIR=/data            # 本番: 永続ディスクのマウント先

# 本番向け。いずれもNODE_ENVからは独立していて、明示的に指定したときだけ効く。
# STATIC_DIR: ビルド済みフロント(dist/)の配信元。未設定なら配信しない
#             (開発時はViteのdevサーバーが5173で配信するため不要)。
#             相対パスはリポジトリルート基準で解決される。
# SECURE_COOKIES: セッションクッキーのSecure属性(true/false)。
#             未設定ならBASE_URLのスキームから決まる(https=有効/http=無効)。
#             不正な値を入れるとサーバーは起動しない。
# STATIC_DIR=dist
# SECURE_COOKIES=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

LIMIT_MESSAGES_PER_DAY=200
LIMIT_NOVELIZE_PER_DAY=10
LIMIT_IMAGES_PER_DAY=30

# 場面挿絵生成(Google Gemini)。未設定なら挿絵機能はUIごと無効化される。
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
